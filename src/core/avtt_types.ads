package AVTT_Types is

   ------------------------------------------------------------------
   -- Unsigned Integer Types
   ------------------------------------------------------------------

   type UInt8 is mod 2 ** 8;

   type UInt16 is mod 2 ** 16;

   type UInt32 is mod 2 ** 32;

   ------------------------------------------------------------------
   -- Signed Integer Types
   ------------------------------------------------------------------

   type Int8 is range
      -(2 ** 7) ..
       (2 ** 7) - 1;

   type Int16 is range
      -(2 ** 15) ..
       (2 ** 15) - 1;

   type Int32 is range
      -(2 ** 31) ..
       (2 ** 31) - 1;

end AVTT_Types;
